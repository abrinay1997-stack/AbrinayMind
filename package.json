{
  "name": "abrinay-mind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Abrinay Mind — cerebros de artistas conectados por enlaces y significados, para escribir letras. Cloudflare Worker + D1 + Workers AI.",
